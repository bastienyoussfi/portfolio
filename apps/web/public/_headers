# Cloudflare Pages serves every file with `Cache-Control: public, max-age=0,
# must-revalidate` unless a rule here says otherwise. That default is right for
# HTML — it carries the asset hashes, so it has to stay fresh — and wrong for
# everything Astro fingerprints.
#
# Rules are listed most-specific first. `*` matches across slashes on Pages, so
# /_astro/* has to come before the extension rules below it.

# Fonts, JS, CSS and optimised images. The filename contains a hash of the
# bytes, so a change produces a new URL and this can never serve stale content.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed files in public/. A week of browser cache, then revalidate — long
# enough to matter for repeat visits, short enough that replacing the avatar or
# the social card propagates without a cache-busting rename.
/*.svg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/*.jpeg
  Cache-Control: public, max-age=604800

# Applies to the HTML too, which keeps Cloudflare's revalidating default.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
